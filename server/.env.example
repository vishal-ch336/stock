# Server Configuration
PORT=8080
NODE_ENV=development

# MongoDB Atlas Connection
# Get your connection string from https://cloud.mongodb.com
# Replace <username>, <password>, <cluster> with your Atlas credentials
MONGO_URI=
# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=180

# File Upload
MAX_UPLOAD_MB=25

# OCR Feature (optional, requires additional setup)
REALTIME_WS=false
ENABLE_OCR=false
TESSERACT_LANG=eng

# Clerk Authentication
# Get this from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE
